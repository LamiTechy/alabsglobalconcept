# --- Database (Neon serverless Postgres) ---
# From your Neon dashboard: Connection string → Pooling (recommended for serverless)
# Format: postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth ---
# Secret used to sign admin JWT session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
# Session lifetime in seconds (default 7 days)
JWT_EXPIRES_IN="604800"

# Seeded first admin (created by db/migrations/0001_seed_admin.sql, not read from env)
ADMIN_EMAIL="admin@alabsglobalconcept.com"
ADMIN_PASSWORD="change-this-password"

# --- Email notifications (Brevo SMTP relay) ---
# Get SMTP credentials at https://app.brevo.com/settings/keys/smtp — if unset, lead emails are skipped gracefully
# Sender must be a verified sender in Brevo (Settings → Senders → verified)
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="xxxxxxxxxx@smtp-brevo.com"
BREVO_SMTP_PASS="xsmtpsib-xxxxxxxxxxxxxxx"
BREVO_API_FROM="Alabsglobalconcept <noreply@alabsglobalconcept.com>"
# Where quote/lead alert emails are delivered
ADMIN_EMAIL_ALERTS="admin@alabsglobalconcept.com"

# --- Site ---
# Production URL used for canonical links, sitemap, og tags
NEXT_PUBLIC_SITE_URL="https://alabsglobalconcept.com"

# --- Contact (public site) ---
NEXT_PUBLIC_PHONE="+234XXXXXXXXXX"
NEXT_PUBLIC_WHATSAPP="234XXXXXXXXXX"
NEXT_PUBLIC_EMAIL="info@alabsglobalconcept.com"
NEXT_PUBLIC_ADDRESS="Plot 000, Example Street, Maitama, Abuja, FCT"
NEXT_PUBLIC_BUSINESS_HOURS="Mon–Sat, 8am – 6pm"
NEXT_PUBLIC_INSTAGRAM="https://instagram.com/alabsglobalconcept"
NEXT_PUBLIC_FACEBOOK="https://facebook.com/alabsglobalconcept"
NEXT_PUBLIC_X="https://x.com/alabsglobalconcept"
NEXT_PUBLIC_LINKEDIN="https://linkedin.com/company/alabsglobalconcept"

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Rate limiting ---
# Fixed-window limiter uses in-memory store (per server instance).
# For multi-instance prod, back this with Upstash/Redis via the same interface.
RATE_LIMIT_MAX="10"
RATE_LIMIT_WINDOW_MS="60000"
